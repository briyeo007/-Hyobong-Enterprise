# ── 관리자 페이지(/admin) 환경변수 ──
# Vercel → Project → Settings → Environment Variables 에 등록 (Production + Preview)
# 로컬 테스트 시 .env.local 에 동일하게 작성 (.env.local 은 Git에 올라가지 않음)

# Supabase → Project Settings → API (Data API URL / service_role 또는 secret 키)
# ⚠ service_role(secret) 키는 서버 전용입니다. NEXT_PUBLIC_ 접두어를 절대 붙이지 마세요.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 비밀번호 (10자 이상, 추천: 16자 이상 무작위)
ADMIN_PASSWORD=

# 세션 서명용 비밀값 (32자 이상 무작위). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# (선택) Supabase 없이 로컬에서 관리자 기능 테스트: 1 로 설정 시 .local-admin/ 폴더에 저장 (Vercel에서는 무시됨)
# ADMIN_LOCAL_STORE=1
